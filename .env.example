# Required for the Ask-Me-Anything chat. Without it the site still renders in
# full; only the chat degrades to an inline "email me instead" card.
ANTHROPIC_API_KEY=

# Rate limiter for the public chat endpoint (free tier at upstash.com).
# The route refuses to serve chat in production if these are missing — a public
# LLM endpoint with no limiter is an open invoice.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
