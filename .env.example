# Required for the Ask-Me-Anything chat. Get one free at aistudio.google.com.
# Without it the site still renders in full; only the chat degrades to an
# inline "email me instead" card.
GEMINI_API_KEY=

# Rate limiter for the public chat endpoint (free tier at upstash.com).
# The route refuses to serve chat in production if these are missing — a public
# LLM endpoint with no limiter is an open invoice.
#
# You do NOT need a dedicated database. The limiter namespaces its keys with an
# "ama:" prefix, so it can share an existing Upstash Redis with other apps.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
